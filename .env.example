# ── Database ──────────────────────────────────────────────────────────
# SQLite (default — no extra services needed)
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite://finbot.db

# PostgreSQL — uncomment these and run: docker compose --profile postgres up
# DATABASE_TYPE=postgresql
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=finbot

# ── Application ──────────────────────────────────────────────────────
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=super_long_default_key_change_this_in_production

# ── LLM ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Email ────────────────────────────────────────────────────────────
# Use "console" for dev (prints to stdout), "resend" for production
EMAIL_PROVIDER=console
RESEND_API_KEY=resend_api_key_here

# Experiment history + private credential key (share this directory with worker)
FINBOT_EXPERIMENTS_DB=data/experiments.db
FINBOT_EXPERIMENTS_MAX_PARALLEL_JOBS=2
FINBOT_EXPERIMENTS_MAX_PARALLEL_CASES=4

# Shared results archive (local queue and API keys remain in SQLite)
FINBOT_RESULTS_PG_HOST=
FINBOT_RESULTS_PG_PORT=5432
FINBOT_RESULTS_PG_DATABASE=experiments
FINBOT_RESULTS_PG_USER=
FINBOT_RESULTS_PG_PASSWORD=
FINBOT_RESULTS_PG_SSLROOTCERT=/app/certs/server.crt
# Host certificate directory for Docker; put server.crt here before enabling PostgreSQL
FINBOT_RESULTS_CERT_DIR=./certs
# Optional absolute host path when mounting the certificate as a single file.
# FINBOT_RESULTS_CERT_FILE=/absolute/path/to/server.crt

# Optional fixed post-run observer. Only used when evaluate_iterations=true.
# Keep this observer fixed across experiments; returned modelVersion is recorded.
FINBOT_JUDGE_MODEL=gemini-flash-lite-latest
FINBOT_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-lite-latest:generateContent
FINBOT_JUDGE_API_KEY=
FINBOT_JUDGE_KIND=gemini
# Gemini uses OPENAI_API_KEY in X-goog-api-key; FINBOT_JUDGE_API_KEY is for other adapters.
FINBOT_JUDGE_ALLOW_PRIVATE_NETWORK=false
FINBOT_JUDGE_USE_ENV_PROXY=false
# FINBOT_JUDGE_TEMPERATURE=0

# ── Magic Link ───────────────────────────────────────────────────────
MAGIC_LINK_BASE_URL=http://localhost:8000
